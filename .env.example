# Copy to .env for local development. On Vercel, set these under
# Project Settings > Environment Variables instead.

# Required. Use your provider's POOLED connection string in serverless
# (Neon's -pooler host, Supabase port 6543), not the direct one.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Required for /api/export. Any long random string; generate one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_TOKEN=

# Optional, and intentionally unset for this round: there is no booking tool
# yet, so the working-session screen asks the vendor to reply with times that
# suit them. Set this to a Calendly or Bookings URL later and the page shows a
# booking button instead, with no code change. Served from here rather than
# hardcoded so the link never appears in page source.
SCHEDULING_URL=

# Optional. When set, only links generated by `npm run links` are accepted,
# which stops anyone who views page source from writing junk to the tracker.
LINK_SIGNING_SECRET=

# Optional. Salt for the hashed client IP stored against each event.
IP_HASH_SALT=

# Optional. Submissions allowed per client per minute. 0 disables the limit.
RATE_LIMIT_PER_MINUTE=20

# Only needed by `npm run links`, to build the vendor URLs.
BASE_URL=https://respond.specinsite.com
